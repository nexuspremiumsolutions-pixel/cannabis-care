# ==============================================================================
# CANNABIS CARE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Nexus Premium Solutions SAS
# ==============================================================================
# NOTE: Never commit real secret keys to source control.
# Copy this file to .env in your secure deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (SERVER_ONLY)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_min_32_chars
ALLOW_DEV_SEEDS=false

# ------------------------------------------------------------------------------
# 2. AI ASSISTANT & KNOWLEDGE ENGINE (SERVER_ONLY)
# ------------------------------------------------------------------------------
# Google Gemini API key for server-side AI reasoning & health advice validation
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY & MARKETPLACE PSP (SERVER_ONLY)
# ------------------------------------------------------------------------------
# Stripe or PCI-DSS compliant PSP secrets
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_CLIENT_ID=
PAYMENT_PROVIDER_ENVIRONMENT=live
PAYMENT_MODE=live

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL COMMUNICATIONS & EMAILS (SERVER_ONLY)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_PROVIDER_API_KEY=your_transactional_email_provider_api_key
EMAIL_FROM_ADDRESS=CANNABIS CARE <notifications@cannabis-care.fr>
EMAIL_REPLY_TO=support@cannabis-care.fr

# ------------------------------------------------------------------------------
# 5. CARRIER & LOGISTICS INTEGRATIONS (SERVER_ONLY)
# ------------------------------------------------------------------------------
COLISSIMO_API_KEY=
COLISSIMO_ACCOUNT_NUMBER=
CHRONOPOST_API_KEY=
CHRONOPOST_ACCOUNT_NUMBER=
MONDIAL_RELAY_API_KEY=

# ------------------------------------------------------------------------------
# 6. MONITORING & CLOUD TELEMETRY (SERVER_ONLY)
# ------------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. FRONTEND PUBLIC ENVIRONMENT VARIABLES (CLIENT-SAFE)
# ------------------------------------------------------------------------------
VITE_APP_TITLE=Cannabis Care
VITE_APP_DESCRIPTION=Plateforme d'accompagnement bien-être, réduction des risques et marketplace CBD éthique
VITE_SUPPORT_EMAIL=support@cannabis-care.fr
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

